# 이 파일을 .env로 복사해서 사용한다. (.env는 GitHub에 올라가지 않는다)
PORT=3000

# 저장소 선택: sqlite(길 A, 로그인 없음) 또는 supabase(길 B, 로그인 필요)
DB_PROVIDER=sqlite

# 길 A - SQLite 파일 위치
DB_PATH=./todo.db

# 길 B - Supabase 대시보드 > Project Settings > API 에서 복사
SUPABASE_URL=
SUPABASE_ANON_KEY=

# 접속을 받을 주소 (비워 두면 sqlite는 127.0.0.1 = 이 컴퓨터만, supabase는 0.0.0.0)
# HOST=
# Render 같은 프록시 뒤에서 실행할 때만 1로 설정 (로그인 시도 제한을 실제 접속자 IP로 계산)
# TRUST_PROXY=1
